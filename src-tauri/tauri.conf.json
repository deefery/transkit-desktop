{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "TransKit",
    "version": "3.3.5-deefery.10"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": true,
        "open": ".*"
      },
      "path": {
        "all": true
      },
      "window": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://**",
          "https://**"
        ]
      },
      "os": {
        "all": true
      },
      "protocol": {
        "asset": true,
        "assetScope": [
          "$CACHE/**",
          "$CONFIG/**"
        ]
      },
      "fs": {
        "all": true,
        "scope": [
          "$APPCONFIG/**",
          "$APPCACHE/**",
          "$DOCUMENT/**"
        ]
      },
      "dialog": {
        "open": true,
        "save": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "GPLv3",
      "targets": "all",
      "identifier": "com.transkit.desktop",
      "longDescription": "A cross-platform text translation and ocr software",
      "shortDescription": "TransKit",
      "externalBin": [],
      "resources": ["scripts/**"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "deb": {
        "depends": [
          "libxdo-dev",
          "libxcb1",
          "libxrandr2",
          "tesseract-ocr"
        ]
      },
      "rpm": {
        "depends": [
          "libxdo-dev",
          "libxcb1",
          "libxrandr2",
          "tesseract-ocr"
        ]
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: asset: https://asset.localhost https:; media-src 'self' data: blob: mediastream:; connect-src 'self' ipc: https://ipc.localhost data: blob: https: http: wss: ws:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: asset: https://asset.localhost https:; media-src 'self' data: blob: mediastream:; connect-src 'self' ipc: https://ipc.localhost data: blob: https: http: wss: ws:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Daemon",
        "label": "daemon",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "url": "daemon.html",
        "additionalBrowserArgs": "--disable-web-security"
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MDY3ODA3OEMzOTdBRUIKUldUcmVqbU1CM2dHeER2UGQ3YU42YlQ2cWRBVkdGbjB0UTUyL0tKRW5sbHNTa252YVg3THNNWVEK"
    }
  }
}
